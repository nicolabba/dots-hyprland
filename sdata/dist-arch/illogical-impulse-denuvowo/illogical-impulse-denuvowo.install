_dkms_module=cpuid_fault_emulation
_dkms_version=0.1
_dkms_name="${_dkms_module}/${_dkms_version}"
_dkms_source_dir="/usr/src/${_dkms_module}-${_dkms_version}"

_dkms_is_registered() {
  dkms status "${_dkms_name}" 2>/dev/null | grep -q "^${_dkms_name}"
}

_dkms_add_if_needed() {
  if _dkms_is_registered; then
    echo "${_dkms_name} is already registered with DKMS; skipping dkms add."
    return 0
  fi

  cd "${_dkms_source_dir}" || exit 1
  dkms add .
}

_dkms_remove() {
  dkms remove "${_dkms_name}" --all --force 2>/dev/null || true
}

post_install() {
  _dkms_add_if_needed
}

pre_upgrade() {
  _dkms_remove
}

post_upgrade() {
  _dkms_add_if_needed
}

pre_remove() {
  _dkms_remove
}
